<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Tutorial Text Card (Clean text only, no broken viewpager/images) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/quick_launch_card_bg"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quick_launch_tutorial_1"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quick_launch_tutorial_2"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Main Switch Card -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/quick_launch_card_bg"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/switch_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/quick_launch_title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/quick_launch_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

        <!-- Current Menu Section Header -->
        <RelativeLayout
            android:id="@+id/current_menu_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/quick_launch_current_menu"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_edit_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@string/quick_launch_edit"
                android:textColor="?android:attr/colorAccent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <!-- Current Menu Slots Preview Card -->
        <LinearLayout
            android:id="@+id/current_menu_card"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/quick_launch_card_bg"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Radial slots container -->
            <RelativeLayout
                android:id="@+id/slots_preview_container"
                android:layout_width="180dp"
                android:layout_height="180dp">

                <!-- Slot 1 (Top Center) -->
                <FrameLayout
                    android:id="@+id/slot_top"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/quick_launch_dotted_slot">
                    <ImageView
                        android:id="@+id/slot_top_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />
                </FrameLayout>

                <!-- Slot 2 (Left) -->
                <FrameLayout
                    android:id="@+id/slot_left"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/quick_launch_dotted_slot">
                    <ImageView
                        android:id="@+id/slot_left_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />
                </FrameLayout>

                <!-- Slot 3 (Center) -->
                <FrameLayout
                    android:id="@+id/slot_center"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/quick_launch_dotted_slot">
                    <ImageView
                        android:id="@+id/slot_center_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />
                </FrameLayout>

                <!-- Slot 4 (Right) -->
                <FrameLayout
                    android:id="@+id/slot_right"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/quick_launch_dotted_slot">
                    <ImageView
                        android:id="@+id/slot_right_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />
                </FrameLayout>

            </RelativeLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
